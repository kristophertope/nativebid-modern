{
  "manifest_version": 3,
  "name": "NativeBid Modern",
  "version": "0.2.0",
  "description": "A clean, image-first interface for nativebid.com.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["https://www.nativebid.com/*", "https://nativebid.com/*"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "trackers",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://www.nativebid.com/*", "https://nativebid.com/*"],
      "js": ["boot.js", "styles.js", "app.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.nativebid.com/*", "https://nativebid.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_end",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/favicon.svg"],
      "matches": ["https://www.nativebid.com/*", "https://nativebid.com/*"]
    }
  ]
}
