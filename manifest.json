{
  "manifest_version": 3,
  "name": "NativeBid Modern",
  "version": "0.1.0",
  "description": "A clean, image-first interface for nativebid.com.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.nativebid.com/*", "https://nativebid.com/*"],
      "js": ["boot.js"],
      "css": ["boot.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.nativebid.com/*", "https://nativebid.com/*"],
      "js": ["styles.js", "app.js"],
      "run_at": "document_end"
    }
  ]
}
